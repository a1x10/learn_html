# ─────────────────────────────────────────────────────────────
#  STELLA — настройки. Скопируйте файл:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

PORT=3000
# Реальный IP посетителя за прокси (нужен для защиты от спама кодами):
#   auto — доверять X-Forwarded-For только от прокси из внутренней сети (подходит для Render, Railway, Nginx)
#   1    — доверять всегда (например, за Cloudflare)   0 — никогда
TRUST_PROXY=auto
# Часовой пояс для времени в уведомлениях
TIMEZONE=Europe/Moscow

# ── Telegram: куда приходят заявки «Создать агента» ──────────
# 1) Создайте бота у @BotFather → получите токен
# 2) Напишите своему боту /start
# 3) npm run chat-id  → покажет ваш TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
# Можно несколько через запятую (вы, менеджер, группа)
TELEGRAM_CHAT_ID=

# ── WhatsApp: код подтверждения номера ───────────────────────
#  console  — для проверки: код показывается в консоли сервера и на экране
#  greenapi — ваш запасной номер подключается к WhatsApp по QR-коду (https://green-api.com)
#  meta     — официальный WhatsApp Cloud API
WA_PROVIDER=console

# Green API: в личном кабинете создайте инстанс, отсканируйте QR с телефона,
# где установлен WhatsApp на вашем запасном номере, и скопируйте данные:
GREEN_API_URL=https://api.green-api.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=

# Meta WhatsApp Cloud API (developers.facebook.com → WhatsApp):
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
# Шаблон категории Authentication с параметром {{1}} (код) и кнопкой «Копировать код»
META_WA_OTP_TEMPLATE=
META_WA_OTP_BUTTON=1
META_WA_LANG=ru
# Необязательно: шаблон для сообщения «заявка принята» (без параметров)
META_WA_ACK_TEMPLATE=

# Текст кода ({code} заменяется на код)
WA_OTP_TEXT=STELLA: ваш код подтверждения — {code}. Никому не сообщайте этот код. Код действует 10 минут.

# Отправлять клиенту в WhatsApp «Заявка принята» после нажатия «Создать агента»
WA_SEND_ACK=1

# ── Капча ────────────────────────────────────────────────────
# По умолчанию — встроенный 3D-пазл. Для максимальной защиты от ботов
# подключите Cloudflare Turnstile (бесплатно): dash.cloudflare.com → Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Если сайт и API на разных доменах ────────────────────────
# Например, сайт на GitHub Pages, а сервер на VPS: укажите адрес сайта
CORS_ORIGIN=
